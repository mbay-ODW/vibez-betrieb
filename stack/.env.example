# Vorlage für /opt/vibez/stack/.env auf dem Server (NIE ins Repo committen; chmod 600, Besitzer root).
# Werte erzeugen z. B. mit:  openssl rand -base64 36 | tr -d '/+=' | cut -c1-40

# Adresse der App
VN_HOST=nachweise.vibez-odenwald.de

# Feste Versionen (nur über deploy.sh ändern). App immer mit Digest, damit niemand die Version austauschen kann:
#   docker buildx imagetools inspect ghcr.io/mbay-odw/vibez-nachweise:0.2.5 --format '{{json .Manifest.Digest}}'
VN_VERSION=0.2.5@sha256:DIGEST
TRAEFIK_VERSION=v3.7.17
CLOUDFLARED_VERSION=2026.10.7
# Werkzeug-Image für mongodump/mongorestore (Version passend zum Atlas-Cluster)
MONGO_TOOLS_VERSION=8.0

# App
VN_SECRET_KEY=
# Startpasswort für den ersten Verwaltungszugang „tobias“ – wirkt nur beim allerersten Start
VN_ADMIN_PASSWORD=

# MongoDB Atlas (Projekt „VIBEZ Nachweise“, Cluster in AWS Frankfurt eu-central-1)
# Anmeldung per X.509 (von Atlas verwaltete Zertifikate, auf dem Server erzeugt, in stack/secrets/, 24 Monate gültig).
# Adressen in Anführungszeichen: sie enthalten „&“ und die Datei wird von backup.sh mit „source“ gelesen.
# App-Benutzer „prod“: Rolle readWrite nur auf Datenbank „vibez“
MONGODB_URI="mongodb+srv://CLUSTER.mongodb.net/vibez?authSource=%24external&authMechanism=MONGODB-X509&tls=true&retryWrites=true&w=majority&tlsCertificateKeyFile=/run/secrets/atlas-app.pem&appName=vibez-nachweise"
# Backup-Benutzer „vibez_backup“: nur read auf „vibez“ (reicht für mongodump einer Datenbank)
MONGODB_BACKUP_URI="mongodb+srv://CLUSTER.mongodb.net/?authSource=%24external&authMechanism=MONGODB-X509&tls=true&retryWrites=true&w=majority&tlsCertificateKeyFile=/certs/atlas-backup.pem&appName=vibez-backup"

# Backup (restic in Docker, Ziel: Hetzner Storage Box per SFTP)
RESTIC_VERSION=0.18.0
RESTIC_REPOSITORY=sftp:u000000@u000000.your-storagebox.de:/vibez-restic
# Passwort der restic-Verschlüsselung – zusätzlich OFFLINE im Passwortmanager von VIBEZ hinterlegen!
RESTIC_PASSWORD=
# Heartbeat-URL (Uptime Kuma „Push“-Monitor), wird nach jedem erfolgreichen Backup aufgerufen
BACKUP_PING_URL=
