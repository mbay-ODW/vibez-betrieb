# Vorlage für stack-admin/.env auf dem Server (chmod 600, root). Versionen fest, Aktualisieren bewusst von Hand.
REDIS_VERSION=8.8.4-alpine
LLDAP_VERSION=v0.6.3
AUTHELIA_VERSION=4.39.28
PORTAINER_VERSION=2.45.3
DOZZLE_VERSION=v11.4.3
UPTIME_KUMA_VERSION=2.5.12
# Schlüssel für die Passwort-Hashes in LLDAP – auf dem Server erzeugen (openssl rand), nie ändern
LLDAP_KEY_SEED=
