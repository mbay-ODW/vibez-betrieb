# Vorlage für stack-testing/.env (chmod 600, root). Nur erfundene Daten.
VN_TESTING_VERSION=testing@sha256:DIGEST
MONGODB_URI_TESTING="mongodb+srv://CLUSTER.mongodb.net/vibez?authSource=%24external&authMechanism=MONGODB-X509&tls=true&retryWrites=true&w=majority&tlsCertificateKeyFile=/run/secrets/atlas-testing.pem&appName=vibez-testing"
VN_SECRET_KEY_TESTING=
# muss auch in stack/.env stehen (Traefik setzt es für nachweise-testing)
VN_PROXY_SECRET_TESTING=
